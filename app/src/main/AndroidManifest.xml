<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 작업 14: NaviHelper 경로 요청과 Vehicle 기어 구독 (docs/sdk-findings.md) -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE_SEARCH" />
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />
    <!-- 작업 20: 경고등 구독(R8). PRIVATE_CAR_SAFETY는 실제 차량에서 승인이 필요할 수 있다 -->
    <uses-permission android:name="pleos.car.permission.CAR_SAFETY" />
    <uses-permission android:name="pleos.car.permission.PRIVATE_CAR_SAFETY" />

    <!-- SPEC R11-21: [내비에서 검색하기]로 현대차 내비 앱을 띄우려면 그 패키지를 조회할 수 있어야 한다(Android 11 패키지 가시성). 실차 패키지는 확인 필요 -->
    <queries>
        <package android:name="ai.umos.maps.android.navigation.app" />
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Convoy">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|uiMode|keyboardHidden">
            <!-- 화면 나누기·크기·주야간이 바뀌어도 액티비티를 다시 만들지 않는다(그룹·사고 상태가 액티비티에 있다). Compose가 새 크기로 다시 그린다(R11-20 좁은 창) -->
            <!-- 주행 중에도 화면을 보여 준다(R8 사고 확인 응답, R10). 없으면 D에서 "주행 중에는 사용할 수 없습니다"로 가려진다. 실차는 심사가 필요할 수 있다 -->
            <meta-data android:name="distractionOptimized" android:value="true" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
